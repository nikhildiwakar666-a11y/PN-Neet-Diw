# =========================================================================
# PN NEET DIW — Environment Variables Template
# Copy this to .env and provide your production secrets.
# NEVER commit .env to Git!
# =========================================================================

PORT=3000
JWT_SECRET=your-jwt-secret-key-at-least-32-chars

# Supabase Central Production Database & Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Production Administrator (Created automatically in Supabase on startup)
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-secure-admin-password

# Optional Faculty / Teacher Account
TEACHER_NAME=Faculty Member
TEACHER_EMAIL=teacher@example.com
TEACHER_PASSWORD=your-secure-teacher-password

# SMTP Email Service (Gmail / Brevo / Resend / AWS SES) for Verification & Password Reset Emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-smtp-app-password
SMTP_FROM="PN Neet Diw" <your-email@gmail.com>

# Frontend & Backend Base URLs
FRONTEND_URL=https://pnneet.netlify.app
VITE_API_BASE_URL=https://pnneet-api.onrender.com
